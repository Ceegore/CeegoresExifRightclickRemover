<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ExifRemover.App</RootNamespace>
    <AssemblyName>ExifRemover</AssemblyName>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <StartupObject>ExifRemover.App.Program</StartupObject>
    <Version>1.0.0</Version>
    <Authors>ExifRemover contributors</Authors>
    <Product>ExifRemover</Product>
    <Description>Right-click context-menu tool to remove EXIF and other metadata from JPEG and PNG images losslessly.</Description>
    <Copyright>Copyright (c) ExifRemover contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExifRemover.Engine\ExifRemover.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Suppress WPF's auto-generation of an ApplicationDefinition for any XAML.
         We define App as a plain class in Program.cs; no XAML App.xaml needed. -->
    <ApplicationDefinition Remove="@(ApplicationDefinition)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>