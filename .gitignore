# ============================================================
# ExifRemover .gitignore
# ============================================================
# The repo root holds a self-contained dotnet publish output
# (~70 MB of .NET runtime DLLs + ExifRemover.exe). Those are
# built by `.\install.cmd build` and must NOT be committed.
# ============================================================

# --- Build / publish output ---------------------------------
bin/
obj/
stage/
TestResults/
*.user
*.suo
.vs/
.idea/
.vscode/

# --- Published .NET runtime (root of repo, after install.cmd build) ---
# ExifRemover.exe and its sibling native files all come from
# `dotnet publish` and are reproducible from source. Don't commit them.
ExifRemover.exe
ExifRemover.dll
ExifRemover.Engine.dll
ExifRemover.Engine.pdb
ExifRemover.deps.json
ExifRemover.runtimeconfig.json
# Catch-all for the rest of the .NET runtime payload (coreclr, hostfxr,
# presentation framework, WindowsBase, accessibility, etc.) that lands
# next to the published exe.
*.dll
*.pdb
*.exe
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json
hostfxr.dll
hostpolicy.dll
coreclr.dll
clr*.dll
vcruntime*.dll
mscord*.dll
createdump.exe
msquic.dll
Microsoft.CSharp.dll
Microsoft.DiaSymReader.Native.amd64.dll
Microsoft.VisualBasic*.dll
Microsoft.Win32*.dll
System.*.dll
netstandard.dll
Presentation*.dll
ReachFramework.dll
UIAutomation*.dll
WindowsBase.dll
WindowsFormsIntegration.dll
wpfgfx_cor3.dll
XamlBuild*.dll
XmpCore.dll
PenImc_cor3.dll
MetadataExtractor.dll
Accessibility.dll
DirectWriteForwarder.dll
D3DCompiler*.dll

# --- Tool config / agent scratch ----------------------------
.claude/
.mavis/
tools/_ci_run/
*.tmp
*.bak
*_old.*

# --- OS junk -----------------------------------------------
Thumbs.db
.DS_Store
desktop.ini

# --- Local Python artifacts --------------------------------
__pycache__/
*.pyc

test_output.txt
test_help.cmd
tmp_probe/
tmp_probe_output.txt